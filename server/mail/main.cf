compatibility_level = 3.6
myhostname = perimove.com
mydomain = perimove.com
myorigin = $mydomain
mydestination = localhost
inet_interfaces = all
inet_protocols = ipv4
mynetworks = 127.0.0.0/8 172.30.90.0/24
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks, reject
smtpd_sender_restrictions = check_sender_access regexp:/etc/postfix/allowed-senders, reject
disable_vrfy_command = yes
smtpd_helo_required = yes
smtpd_tls_security_level = encrypt
smtpd_tls_cert_file = /run/secrets/smtp_cert
smtpd_tls_key_file = /run/secrets/smtp_key
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_mandatory_exclude_ciphers = aNULL
smtp_tls_security_level = verify
smtp_tls_verify_cert_match = hostname
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_loglevel = 0
maillog_file = /dev/stdout
message_size_limit = 1048576
maximal_queue_lifetime = 20m
bounce_queue_lifetime = 20m
minimal_backoff_time = 60s
maximal_backoff_time = 300s
queue_run_delay = 60s
smtpd_client_connection_count_limit = 5
smtpd_client_message_rate_limit = 30
