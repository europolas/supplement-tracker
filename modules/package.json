{
  "name": "@europolas/app-modules",
  "version": "1.12.2",
  "type": "module",
  "description": "Reusable browser and Node modules for mobile PWA applications",
  "files": [
    "src",
    "server",
    "styles",
    "README.md",
    "PROVENANCE.md",
    "docs",
    "AGENTS.md",
    "examples",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.js",
    "./*": "./src/*.js",
    "./styles.css": "./styles/base.css",
    "./server/auth": "./server/AuthApi.mjs",
    "./server/migrations": "./server/migrations.mjs",
    "./server/security": "./server/security.mjs",
    "./server/credential-vault": "./server/credential-vault.mjs",
    "./server/structured-chat": "./server/structured-chat.mjs",
    "./server/structured-research": "./server/structured-research.mjs",
    "./server/task-queue": "./server/task-queue.mjs",
    "./server/workflow-store": "./server/workflow-store.mjs",
    "./server/activity-history": "./server/activity-history.mjs",
    "./examples/*": "./examples/*.mjs",
    "./examples/custom-icon": "./examples/custom-icon.js",
    "./examples/password-visibility": "./examples/password-visibility.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5"
  }
}
